<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>vaporcmd</RootNamespace>
    <AssemblyName>vaporcmd</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.1.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
    <PackageReference Include="Facepunch.Steamworks.Dll" Version="1.62.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="steam_appid.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="vaporcmd.md" />
  </ItemGroup>

  <Target Name="CopySteamNativeDll" AfterTargets="ResolvePackageAssets" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <_SteamDllFilePath>$(NuGetPackageRoot)facepunch.steamworks.dll\1.62.0\runtimes\win-x64\native\steam_api64.dll</_SteamDllFilePath>
    </PropertyGroup>
    <Copy SourceFiles="$(_SteamDllFilePath)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
